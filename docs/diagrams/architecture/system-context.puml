@startuml system-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context — Vid2Tweet

Person(user, "Content Creator", "Submits a YouTube URL, reviews the generated tweet, and decides whether to publish it")

System(vid2tweet, "Vid2Tweet", "Transforms YouTube videos into reviewable tweets through Kestra workflows")

System_Ext(youtube, "YouTube", "Video source, restricted-access cookies, and static thumbnail host")
System_Ext(groq, "Groq API", "Whisper transcription + Llama 3.3 generation")
System_Ext(twitter, "X / Twitter API", "Tweet publishing via OAuth 2.0 or OAuth 1.0a")

Rel(user, vid2tweet, "Starts pipeline, reviews tweet, approves/rejects", "Browser")
Rel(vid2tweet, youtube, "Downloads audio and thumbnails", "HTTPS / yt-dlp")
Rel(vid2tweet, groq, "Transcribes and generates tweet text", "REST API")
Rel(vid2tweet, twitter, "Publishes final tweet", "REST API")

@enduml
