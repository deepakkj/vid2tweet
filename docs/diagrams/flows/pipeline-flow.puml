@startuml pipeline-flow
title Vid2Tweet Pipeline Flow

start

:User submits YouTube URL + cookies;
:Frontend triggers Kestra content-pipeline;

fork
  :extract-image;
  :Resolve video ID;
  :Download YouTube thumbnail;
fork again
  :download-audio;
  :Download and compress MP3;
  :Fail if duration > 20 min or size > 25 MB;
end fork

:transcribe-audio;
:Call Groq Whisper;

:generate-tweet;
:Call Groq Llama 3.3;
:Validate tweet <= 280 chars;

:human_approval pause;
note right
Pause duration: 24h
Resume payload:
- approved
- edited_tweet
end note

if (Approved?) then (yes)
  :Resolve final tweet;
  :Validate edited text <= 280 chars;

  if (Dry run?) then (yes)
    :Create mock tweet result;
  else (no)
    if (OAuth2 token available?) then (yes)
      :Post text tweet via X OAuth 2.0;
    else (no)
      :Download thumbnail by video_id;
      :Upload media via OAuth 1.0a;
      :Post tweet with media;
    endif
  endif

  :Save POSTED result to PostgreSQL;
else (no)
  :Resolve rejected tweet text;
  :Save REJECTED result to PostgreSQL;
endif

stop

@enduml
